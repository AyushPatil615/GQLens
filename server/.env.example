# ── GQLens Server — Environment Variables ────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit real secrets.

# JWT signing secret — generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-your-own-generated-secret

# JWT token lifetime in seconds (default: 3600 = 1 hour)
JWT_EXPIRES_IN=3600

# Server port (default: 4000)
PORT=4000

# Database URL (leave blank to use local SQLite)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
